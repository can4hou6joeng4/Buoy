{
  // 【必填】Telegram Bot Token
  // 获取方式：向 @BotFather 发送 /newbot 命令创建机器人，会获得一个 Token
  // 示例："123456789:ABCdefGHIjklMNOpqrsTUVwxyz"
  "bot_token": "",

  // 【必填】Telegram Chat ID
  // 获取方式：向 @userinfobot 发送任意消息，它会返回你的 Chat ID
  // 对于个人聊天，通常是一个数字，如："123456789"
  // 对于群组，以 "-" 开头，如："-987654321"
  "chat_id": "",

  // 【可选】平台特定设置
  "platform_settings": {
    // 消息类型（解析模式）：HTML | MarkdownV2
    // - HTML：支持 <b>、<i>、<a> 等 HTML 标签（推荐，默认值）
    // - MarkdownV2：Telegram 新版 Markdown 语法（需要转义特殊字符）
    // 官方文档：https://core.telegram.org/bots/api#formatting-options
    "message_type": "HTML",

    // 是否禁用网页预览，设置为 true 时不展示链接预览
    "disable_web_page_preview": false,

    // 是否禁用通知声音，设置为 true 时静默发送
    "disable_notification": false,

    // 是否保护内容，设置为 true 时禁止转发和保存
    "protect_content": false,
  },

  // 【可选】自定义通知模板（不设置，或为空时使用下方默认模板）
  "template": {
    // 通知标题，不设置，或为空字符串时不展示
    "title": "{% if has_failed %}{% if only_credential_expired_failures %}🔑 AnyRouter 凭据异常{% else %}❌ AnyRouter 签到异常{% endif %}{% else %}{% if has_upstream_fault %}🚧 AnyRouter 上游异常{% else %}{% if has_balance_changed %}💰 AnyRouter 额度更新{% else %}{% if has_first_seen %}🆕 AnyRouter 新账号接入{% else %}🔔 AnyRouter 签到提醒{% endif %}{% endif %}{% endif %}{% endif %}",

    // 通知内容
    "content": "{# Telegram 账号明细模板：每个成功账号压缩为一行 #}{% if timestamp %}<b>⏰ 执行时间：</b>{{ timestamp }}{% if timezone %} {{ timezone }}{% endif %}\n{% endif %}{% for account in success_accounts %}<b>💰 {{ account.name }}</b>｜额度 ${{ account.quota }}｜已用 ${{ account.used }}{% if account.balance_changed %}{% if all_balance_changes_uniform %}{% else %}{% if account.quota_delta %}｜💹 {{ account.quota_delta_display }}{% endif %}{% if account.used_delta %}｜📈 {{ account.used_delta_display }}{% endif %}{% endif %}{% endif %}\n{% endfor %}{% if has_credential_expired %}<b>🔑 凭据失效：</b>{{ credential_expired_count }} 个（{{ credential_expired_account_names }}）\n<b>🛠️ 处理建议：</b>检查账号密码或账号状态；系统将在后续运行继续尝试刷新。\n{% endif %}{% for account in other_failed_accounts %}<b>❌ {{ account.name }}：</b>{{ account.error }}\n{% endfor %}{% if has_upstream_fault %}<b>🚧 上游故障：</b>{{ upstream_fault_message }}\n<b>📡 影响范围：</b>{{ stats.upstream_fault_count }}/{{ stats.total_count }}\n{% endif %}{% if has_first_seen %}<b>🆕 新增账号：</b>{{ first_seen_account_names }}｜额度基线已建立\n{% endif %}{% if has_balance_changed %}{% if all_balance_changes_uniform %}{% if common_quota_delta_display %}<b>💹 共同变化：</b>{{ balance_changed_count }} 个账号额度均 {{ common_quota_delta_display }}{% endif %}{% if common_used_delta_display %}{% if common_quota_delta_display %}｜{% endif %}已用均 {{ common_used_delta_display }}{% endif %}\n{% endif %}{% endif %}<b>📊 签到统计：</b>✅ {{ stats.success_count }}/{{ stats.total_count }}｜❌ {{ stats.failed_count }}/{{ stats.total_count }}{% if has_upstream_fault %}｜🚧 {{ stats.upstream_fault_count }}/{{ stats.total_count }}{% endif %}{% if all_success %}\n🎉 全部账号签到成功！{% endif %}",
  },
}

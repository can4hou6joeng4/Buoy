{
  // 【必填】Telegram Bot Token
  // 获取方式：向 @BotFather 发送 /newbot 命令创建机器人，会获得一个 Token
  // 示例："123456789:ABCdefGHIjklMNOpqrsTUVwxyz"
  "bot_token": "",

  // 【必填】Telegram Chat ID
  // 获取方式：向 @userinfobot 发送任意消息，它会返回你的 Chat ID
  // 对于个人聊天，通常是一个数字，如："123456789"
  // 对于群组，以 "-" 开头，如："-987654321"
  "chat_id": "",

  // 【可选】平台特定设置
  "platform_settings": {
    // 消息类型（解析模式）：HTML | MarkdownV2
    // - HTML：支持 <b>、<i>、<a> 等 HTML 标签（推荐，默认值）
    // - MarkdownV2：Telegram 新版 Markdown 语法（需要转义特殊字符）
    // 官方文档：https://core.telegram.org/bots/api#formatting-options
    "message_type": "HTML",

    // 是否禁用网页预览，设置为 true 时不展示链接预览
    "disable_web_page_preview": false,

    // 是否禁用通知声音，设置为 true 时静默发送
    "disable_notification": false,

    // 是否保护内容，设置为 true 时禁止转发和保存
    "protect_content": false,
  },

  // 【可选】自定义通知模板（不设置，或为空时使用下方默认模板）
  "template": {
    // 通知标题，不设置，或为空字符串时不展示
    "title": "{% if has_failed %}{% if only_credential_expired_failures %}🔑 AnyRouter 凭据异常{% else %}❌ AnyRouter 签到异常{% endif %}{% else %}{% if has_upstream_fault %}🚧 AnyRouter 上游异常{% else %}{% if has_balance_changed %}💰 AnyRouter 额度更新{% else %}{% if has_first_seen %}🆕 AnyRouter 新账号接入{% else %}✅ AnyRouter 签到完成{% endif %}{% endif %}{% endif %}{% endif %}",

    // 通知内容
    "content": "{# Telegram 紧凑通知模板：摘要只出现一次，仅展开变化或异常 #}<b>✅ 签到结果：</b>{{ stats.success_count }}/{{ stats.total_count }}{% if has_credential_expired %}\n<b>🔑 凭据失效：</b>{{ credential_expired_count }} 个（{{ credential_expired_account_names }}）\n<b>🛠️ 处理建议：</b>检查账号密码或账号状态；系统将在后续运行继续尝试刷新。{% endif %}{% for account in other_failed_accounts %}\n<b>❌ {{ account.name }}：</b>{{ account.error }}{% endfor %}{% if has_upstream_fault %}\n<b>🚧 上游故障：</b>{{ upstream_fault_message }}\n<b>📡 影响范围：</b>{{ stats.upstream_fault_count }}/{{ stats.total_count }}{% endif %}{% if has_first_seen %}\n<b>🆕 新增账号：</b>{{ first_seen_account_names }}\n<b>📊 额度基线：</b>已建立{% endif %}{% if has_balance_changed %}{% if all_balance_changes_uniform %}{% if common_quota_delta_display %}\n<b>💰 总额度：</b>{{ balance_changed_count }} 个账号均 {{ common_quota_delta_display }}{% endif %}{% if common_used_delta_display %}\n<b>📈 已用额度：</b>{{ balance_changed_count }} 个账号均 {{ common_used_delta_display }}{% endif %}{% else %}\n<b>📊 额度变化明细</b>\n{{ balance_change_details }}{% endif %}{% endif %}",
  },
}
